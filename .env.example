# =============================================================================
# AVYZOR Website – Environment Variables
# =============================================================================
# Kopieren: cp .env.example .env.local
# Vercel:   Project Settings → Environment Variables
#
# Legende:
#   [PFLICHT]  – für Production-Go-Live erforderlich
#   [OPTIONAL] – Feature funktioniert ohne, mit eingeschränkter Funktion
#   PUBLIC     – im Browser-Bundle sichtbar (NEXT_PUBLIC_*)
#   SERVER     – nur serverseitig, niemals NEXT_PUBLIC_ verwenden
# =============================================================================

# ── Site (PUBLIC) ────────────────────────────────────────────────────────────
# [PFLICHT] Kanonische URL ohne trailing slash
NEXT_PUBLIC_SITE_URL=https://avyzor.de
NEXT_PUBLIC_SITE_NAME=AVYZOR
NEXT_PUBLIC_SITE_EMAIL=kontakt@avyzor.de
NEXT_PUBLIC_SITE_PHONE=+49 123 4567890
NEXT_PUBLIC_SITE_PHONE_HREF=+491234567890
NEXT_PUBLIC_SITE_WHATSAPP=491234567890

# ── Adresse (PUBLIC) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ADDRESS_STREET=Musterstraße 1
NEXT_PUBLIC_ADDRESS_CITY=München
NEXT_PUBLIC_ADDRESS_ZIP=80331
NEXT_PUBLIC_ADDRESS_COUNTRY=Deutschland

# ── Rechtliches / Impressum (PUBLIC) ───────────────────────────────────────────
NEXT_PUBLIC_LEGAL_NAME=AVYZOR – Premium KI-Agentur
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=Gabriel Nachname
NEXT_PUBLIC_VAT_ID=
NEXT_PUBLIC_REGISTER_COURT=
NEXT_PUBLIC_REGISTER_NUMBER=

# ── Social Media (PUBLIC) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/avyzor
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/avyzor
NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/avyzor

# ── Supabase (Datenbank) ───────────────────────────────────────────────────────
# [PFLICHT] PUBLIC – URL und Anon Key für Client (falls benötigt)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# [PFLICHT] SERVER – Service Role für API-Routes (niemals im Client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── E-Mail (Resend) ────────────────────────────────────────────────────────────
# [PFLICHT] SERVER
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=AVYZOR <noreply@avyzor.de>
EMAIL_TO=kontakt@avyzor.de

# ── CRM Admin Dashboard ──────────────────────────────────────────────────────────
# [PFLICHT] SERVER – Passwort/Token für /admin und /api/crm/*
CRM_ADMIN_SECRET=generate-a-long-random-secret

# ── Kundenportal Auth ────────────────────────────────────────────────────────────
# [PFLICHT] SERVER – JWT-Signatur für Portal-Sessions (min. 32 Zeichen)
PORTAL_AUTH_SECRET=generate-a-long-random-secret

# ── Stripe (Online-Zahlungen) ────────────────────────────────────────────────────
# [OPTIONAL] SERVER – ohne Stripe sind Online-Zahlungen deaktiviert
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# ── Calendly (PUBLIC) ────────────────────────────────────────────────────────────
# [OPTIONAL] Externer Kalender-Link
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/avyzor

# ── Cloudflare Turnstile (Spam-Schutz) ─────────────────────────────────────────
# [OPTIONAL] Aktuell vorbereitet, Formular-Anbindung folgt
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── OpenAI (Website-Assistant) ───────────────────────────────────────────────────
# [OPTIONAL] SERVER – Chat-Assistent und OpenAI-TTS-Fallback
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# ── ElevenLabs (Premium TTS) ─────────────────────────────────────────────────────
# [OPTIONAL] SERVER – bevorzugter TTS-Anbieter
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# ── Production / Vercel ──────────────────────────────────────────────────────────
# NODE_ENV=production wird von Vercel automatisch gesetzt.

# [OPTIONAL] Debug-Endpunkte in Production (Standard: aus)
# ENABLE_DEBUG_ENDPOINTS=false

# [OPTIONAL] Monitoring – vorbereitet in instrumentation.ts
# SENTRY_DSN=
