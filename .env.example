# AVYZOR Website – Environment Variables
# Kopieren Sie diese Datei nach .env.local und füllen Sie die Werte aus.

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://avyzor.de
NEXT_PUBLIC_SITE_NAME=AVYZOR
NEXT_PUBLIC_SITE_EMAIL=kontakt@avyzor.de
NEXT_PUBLIC_SITE_PHONE=+49 123 4567890
NEXT_PUBLIC_SITE_PHONE_HREF=+491234567890
NEXT_PUBLIC_SITE_WHATSAPP=491234567890

# ── Adresse ───────────────────────────────────────────
NEXT_PUBLIC_ADDRESS_STREET=Musterstraße 1
NEXT_PUBLIC_ADDRESS_CITY=München
NEXT_PUBLIC_ADDRESS_ZIP=80331
NEXT_PUBLIC_ADDRESS_COUNTRY=Deutschland

# ── Rechtliches (Impressum) ───────────────────────────
NEXT_PUBLIC_LEGAL_NAME=AVYZOR – Premium KI-Agentur
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=Gabriel Nachname
NEXT_PUBLIC_VAT_ID=
NEXT_PUBLIC_REGISTER_COURT=
NEXT_PUBLIC_REGISTER_NUMBER=

# ── Social Media ──────────────────────────────────────
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/avyzor
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/avyzor
NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/avyzor

# ── Supabase (Lead-Speicherung) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (E-Mail-Versand) ───────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=AVYZOR <noreply@avyzor.de>
EMAIL_TO=kontakt@avyzor.de

# ── Stripe (Online-Zahlungen – optional) ──────────────
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# ── Calendly ──────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/avyzor

# ── Cloudflare Turnstile (Spam-Schutz – optional) ─────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
